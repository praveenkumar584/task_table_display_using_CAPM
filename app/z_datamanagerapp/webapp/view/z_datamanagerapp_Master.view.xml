<mvc:View controllerName="zdatamanagerapp.controller.z_datamanagerapp_Master"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:f="sap.ui.layout.form">
    <Page id="page" title="{i18n>title}">

        <content>
        <VBox id="_IDGenVBox" >
            <HBox id="_IDGenHBox" class="sapUiSmallMarginTop firstHBox">
                <Button id="_IDGenButton" text="Add" press=".onAdd" icon="sap-icon://add" type="Emphasized"/>
                <Button id="_IDGenButton1" text="Edit" press=".onEdit" icon="sap-icon://edit" type="Attention" />
                <Button id="_IDGenButton2" text="Delete" press=".onDelete" icon="sap-icon://delete" type="Negative" /> 
                <Button id="_IDGenButton3" text="Refresh" icon="sap-icon://refresh" press=".onRefresh"/> 
            </HBox>
            <Table id="_IDGenTable"  inset="false" items="{/EmployeeBasicInfo}" mode="SingleSelectMaster" selectionChange=".onSelect">
                <columns>
                    <Column id="_IDGenColumn0" class="labelColumn"><Text id="_IDGenText0" text="Employee ID"/></Column>
                    <Column id="_IDGenColumn" class="labelColumn"><Text id="_IDGenText" text="First Name"/></Column>
                    <Column id="_IDGenColumn5" class="labelColumn"><Text id="_IDGenText28" text="Last Name"/></Column>
                    <Column id="_IDGenColumn1" class="labelColumn"><Text id="_IDGenText1" text="Job Title"/></Column>
                </columns>
                <items>
                    <ColumnListItem id="_IDGenColumnListItem">
                    <cells>
                        <Text id="_IDGenText41" text="{employeeID}" />
                        <Text id="_IDGenText4" text="{firstName}"/>
                        <Text id="_IDGenText27" text="{lastName}"></Text>
                        <Text id="_IDGenText5" text="{jobTitle}"/>
                    </cells>
                    </ColumnListItem>
                </items>
            </Table>

            <Panel id="_IDGenPanel"  headerText="More Details of " visible="false" class="sapUiSmallMarginTop">
                <HBox id="_IDGenHBox1" class="secondHBox">
                    <Button id="_IDGenButton6" text="Edit" press=".onEditPanelData" icon="sap-icon://edit" type="Ghost" />
                    <Button id="_IDGenButton5" text="Close" press=".closePanel" type="Reject" ></Button>
                </HBox>
                <f:SimpleForm id="_IDGenSimpleForm1" editable="true" layout="ColumnLayout">
                    <Label id="_IDGenLabel" text="Employee ID"/>
                    <Text id="_IDGenText2" text="{selected>/employeeID}"/>
                    <Label id="_IDGenLabel3" text="Email"/>
                    <Text id="_IDGenText7" text="{selected>/email}"/>
                    <Label id="_IDGenLabel4" text="Department"/>
                    <Text id="_IDGenText8" text="{selected>/department}"/>
                    <Label id="_IDGenLabel5" text="Employment Type"/>
                    <Text id="_IDGenText9" text="{selected>/employmentType}"/>
                    <Label id="_IDGenLabel6" text="Marital Status"/>
                    <Text id="_IDGenText10" text="{selected>/maritalStatus}"/>
                    <Label id="_IDGenLabel7" text="Date of Birth"/>
                    <Text id="_IDGenText11" text="{selected>/birthDate}"/>
                    <Label id="_IDGenLabel8" text="Gender"/>
                    <Text id="_IDGenText13"  text="{selected>/gender}"/>
                    <Label id="_IDGenLabel9" text="Salary"/>
                    <Text id="_IDGenText14"  text="{selected>/salary}"/>
                    <Label id="_IDGenLabel11" text="Hire Date"/>
                    <Text id="_IDGenText16"  text="{selected>/hireDate}"/>
                    <Label id="_IDGenLabel12" text="Address"/>
                    <Text id="_IDGenText17"  text="{selected>/address}"/>
                    <Label id="_IDGenLabel13" text="City"/>
                    <Text id="_IDGenText18"  text="{selected>/city}"/>
                    <Label id="_IDGenLabel14" text="Region"/>
                    <Text id="_IDGenText19"  text="{selected>/region}"/>
                    <Label id="_IDGenLabel15" text="Postal Code"/>
                    <Text id="_IDGenText20"  text="{selected>/postalCode}"/>
                    <Label id="_IDGenLabel16" text="Country"/>
                    <Text id="_IDGenText21"  text="{selected>/country}"/>
                    <Label id="_IDGenLabel17" text="Phone"/>
                    <Text id="_IDGenText22"  text="{selected>/phoneNumber}"/>
                    <Label id="_IDGenLabel18" text="Emergency Contact Name"/>
                    <Text id="_IDGenText23"  text="{selected>/emergencyContactName}"/>
                    <Label id="_IDGenLabel19" text="Emergency Contact Phone"/>
                    <Text id="_IDGenText24"  text="{selected>/emergencyContactPhone}"/>
                    <Label id="_IDGenLabel20" text="Reports To"/>
                    <Text id="_IDGenText25"  text="{selected>/reportsTo}"/>

                </f:SimpleForm>
                </Panel>
        </VBox>

    



    <Panel id="moreInfoPanel" headerText="Editable Mode" visible="false" class="sapUiSmallMarginTop">
        <HBox id="_IDGenHBox2" class="secondHBox">
            <Button id="_IDGenButton10" text="Save" press=".onSaveMoreInfo" icon="sap-icon://save" type="Success" />
            <Button id="_IDGenButton11" text="Close" press=".onCloseMoreInfoEditPanel" type="Reject"/>
        </HBox>
        <f:SimpleForm id="_IDGenSimpleForm2" editable="true" layout="ColumnLayout">
            <Label id="_IDGenLabel43" text="Employee ID"/>
            <Input id="_IDGenInput17" value="{selected>/employeeID}" editable="false" />
            <Label id="_IDGenLabel44" text="Email"/>
            <Input id="_IDGenInput18" value="{selected>/email}"/>
            <Label id="_IDGenLabel45" text="Department"/>
            <Input id="_IDGenInput19" value="{selected>/department}"/>
            <Label id="_IDGenLabel46" text="Gender"/>
            <Select id="_IDGenSelect3" selectedKey="{selected>/gender}">
                <items>
                    <core:Item id="_IDGenItem9" key="" text="--select--"></core:Item>
                    <core:Item id="_IDGenItem12" key="Male" text="Male"/>
                    <core:Item id="_IDGenItem13" key="Female" text="Female"/>
                    <core:Item id="_IDGenItem14" key="Other" text="Other"/>
                </items>
            </Select>
            <Label id="_IDGenLabel47" text="Employment Type"/>
            <Select id="_IDGenSelect4" selectedKey="{selected>/employmentType}">
                <items>
                    <core:Item id="_IDGenItem15" key="" text="--select--"></core:Item>
                    <core:Item id="_IDGenItem16" key="Full Time" text="Full Time"/>
                    <core:Item id="_IDGenItem17" key="Part Time" text="Part Time"/>
                    <core:Item id="_IDGenItem18" key="Contract" text="Contract"/>
                </items>
            </Select>
            <Label id="_IDGenLabel48" text="Marital Status"/>
            <Select id="_IDGenSelect5" selectedKey="{selected>/maritalStatus}">
                <items>
                    <core:Item id="_IDGenItem19" key="" text="--select--"></core:Item>
                    <core:Item id="_IDGenItem20" key="married" text="Married"/>
                    <core:Item id="_IDGenItem21" key="unmarried" text="Unmarried"/>
                </items>
            </Select>
            <Label id="_IDGenLabel49" text="Birth Date"/>
            <DatePicker id="_IDGenDatePicker2" value="{selected>/birthDate}" displayFormat="yyyy-MM-dd" valueFormat="yyyy-MM-dd"/>
            <Label id="_IDGenLabel50" text="Hire Date"/>
            <DatePicker id="_IDGenDatePicker3" value="{selected>/hireDate}" displayFormat="yyyy-MM-dd" valueFormat="yyyy-MM-dd"/>
            <Label id="_IDGenLabel51" text="Salary"/>
            <Input id="_IDGenInput20" value="{selected>/salary}"/>
            <Label id="_IDGenLabel52" text="Address"/>
            <Input id="_IDGenInput21" value="{selected>/address}"/>
            <Label id="_IDGenLabel53" text="City"/>
            <Input id="_IDGenInput22" value="{selected>/city}"/>
            <Label id="_IDGenLabel54" text="Region"/>
            <Input id="_IDGenInput23" value="{selected>/region}"/>
            <Label id="_IDGenLabel55" text="Postal Code"/>
            <Input id="_IDGenInput24" value="{selected>/postalCode}"/>
            <Label id="_IDGenLabel56" text="Country"/>
            <Input id="_IDGenInput25" value="{selected>/country}"/>
            <Label id="_IDGenLabel57" text="Phone"/>
            <Input id="_IDGenInput26" value="{selected>/phoneNumber}"/>
            <Label id="_IDGenLabel58" text="Emergency Contact Name"/>
            <Input id="_IDGenInput27" value="{selected>/emergencyContactName}"/>
            <Label id="_IDGenLabel59" text="Emergency Contact Phone"/>
            <Input id="_IDGenInput28" value="{selected>/emergencyContactPhone}"/>
            <Label id="_IDGenLabel60" text="Reports To"/>
            <Input id="_IDGenInput29" value="{selected>/reportsTo}"/>
        </f:SimpleForm>
    </Panel>
</content>
</Page>
</mvc:View>