<core:FragmentDefinition xmlns="sap.m" xmlns:core="sap.ui.core">
    <Dialog id="editDialog" title="Edit Employee" contentWidth="400px">
        <VBox id="_IDGenVBox2" class="sapUiMediumMargin">
            <Label id="_IDGenLabel1" text="Employee ID" />
            <Input id="empId" editable="false" />

            <Label id="_IDGenLabel2" text="First Name" />
            <Input id="firstName" />

            <Label id="_IDGenLabel10" text="Last Name" />
            <Input id="lastName" />

            <Label id="_IDGenLabel42" text="Job Title" />
            <Input id="jobTitle" />
        </VBox>

        <beginButton>
            <Button id="_IDGenButton4" text="Save" type="Emphasized" press=".onSaveEdit" />
        </beginButton>

        <endButton>
            <Button id="_IDGenButton9" text="Cancel" press=".onCancelEdit" />
        </endButton>
    </Dialog>
</core:FragmentDefinition>
